HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Both capabilities are opt-in. Model IDs have no default: choose one supported
# by your provider/account. These settings never belong in a VITE_ variable.
AI_TEXT_PROVIDER=disabled
AI_IMAGE_PROVIDER=disabled

# Text providers: openai | anthropic | google | openai-compatible
# AI_TEXT_MODEL=your-text-model-id
# Image providers: openai | google | openai-compatible (not Anthropic)
# AI_IMAGE_MODEL=your-image-model-id

# Supply the conventional key for each selected provider, or use per-role keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# AI_TEXT_API_KEY=
# AI_IMAGE_API_KEY=

# Optional endpoint overrides; required for openai-compatible providers.
# Local compatible servers can omit a key when their API does not require one.
# AI_TEXT_BASE_URL=http://127.0.0.1:11434/v1
# AI_IMAGE_BASE_URL=https://your-compatible-service.example/v1

AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_PROMPT_CHARACTERS=50000
AI_TEXT_TIMEOUT_MS=30000
AI_IMAGE_TIMEOUT_MS=120000
