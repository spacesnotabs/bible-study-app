{
  "name": "bible-study-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A guest-friendly Bible reading and study application.",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "import:bsb": "node scripts/import-bsb.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace=@bible-study/api\" \"npm run dev --workspace=@bible-study/web\"",
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build --workspace=@bible-study/web -- --outDir ../../dist --emptyOutDir",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
